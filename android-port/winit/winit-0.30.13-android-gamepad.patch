+
+/// Horizon: the sources a controller (a gamepad, a joystick or a TV remote's
+/// D-pad) reports. Android sets both the GAMEPAD and the JOYSTICK bit on most
+/// pads; `is_joystick_class` catches the ones that only set the second.
+fn gamepad_source(source: android_activity::input::Source) -> bool {
+    use android_activity::input::Source;
+    source.is_joystick_class()
+        || matches!(
+            source,
+            Source::Gamepad | Source::Joystick | Source::Dpad
+        )
+}
+
+/// Horizon: the controller axes sent with each motion event: both sticks, the
+/// D-pad hat and both triggers.
+const GAMEPAD_AXES: [android_activity::input::Axis; 8] = [
+    android_activity::input::Axis::X,
+    android_activity::input::Axis::Y,
+    android_activity::input::Axis::Z,
+    android_activity::input::Axis::Rz,
+    android_activity::input::Axis::HatX,
+    android_activity::input::Axis::HatY,
+    android_activity::input::Axis::Ltrigger,
+    android_activity::input::Axis::Rtrigger,
+];
